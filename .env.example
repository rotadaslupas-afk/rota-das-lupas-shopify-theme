# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser commitado (já está no .gitignore).

# --- GitHub ---
GH_TOKEN=

# --- Shopify ---
SHOPIFY_FLAG_STORE=
SHOPIFY_CLI_THEME_TOKEN=
# Senha de visitante da loja (Online Store > Preferências > Proteção por senha).
# Necessária para o "shopify theme dev" renderizar o preview da loja protegida.
SHOPIFY_FLAG_STORE_PASSWORD=
