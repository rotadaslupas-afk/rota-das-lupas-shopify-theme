<script
  src="{{ 'rota-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign video = section.settings.video
  assign image_fallback = section.settings.image
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<rota-reveal
  class="
    rota-narrativa
    section
    spacing-style
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="rota-narrativa__content" data-reveal>
    {% content_for 'blocks' %}
  </div>

  {% if video %}
    <div class="rota-narrativa__band" data-reveal>
      <video
        class="rota-narrativa__video"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        {% if video.preview_image %}poster="{{ video.preview_image | image_url: width: 1600 }}"{% endif %}
        aria-label="Camelo da Rota das Lupas andando no deserto"
      >
        {% for source in video.sources %}
          {% if source.format == 'mp4' %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endif %}
        {% endfor %}
      </video>
    </div>
  {% elsif image_fallback %}
    <div class="rota-narrativa__band" data-reveal>
      {{
        image_fallback
        | image_url: width: 2000
        | image_tag:
          widths: '600, 1000, 1400, 2000',
          sizes: '100vw',
          class: 'rota-narrativa__video',
          loading: 'lazy'
      }}
    </div>
  {% endif %}
</rota-reveal>

{% stylesheet %}
  rota-reveal.rota-narrativa {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--gap-lg) * 1.4);
    padding-inline: 0;
  }

  .rota-narrativa__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-md);
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
    padding-inline: var(--gutter, 1.5rem);
    text-align: center;
  }

  /* Faixa de vídeo em largura total — lado a lado, o camelo INTEIRO andando.
     A faixa usa a proporção do vídeo (16:9) para mostrar o quadro completo,
     sem cortar as patas. */
  .rota-narrativa__band {
    width: 100%;
    aspect-ratio: 1916 / 1080;
    overflow: hidden;
    position: relative;
    line-height: 0;
  }

  .rota-narrativa__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* só espelha (o camelo anda para a direita); sem zoom, para o corpo todo aparecer */
    transform: scaleX(-1);
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rota-reveal--ready [data-reveal] {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 0.8s ease,
        transform 0.8s ease;
    }

    .rota-reveal--ready [data-reveal]:nth-child(2) {
      transition-delay: 0.15s;
    }

    /* o reveal não pode brigar com o espelhamento do vídeo */
    .rota-reveal--ready .rota-narrativa__band.is-revealed {
      opacity: 1;
      transform: none;
    }
    .rota-reveal--ready [data-reveal].is-revealed {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "A Rota — narrativa",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo (camelo andando)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem (fallback, se não houver vídeo)"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Largura",
      "options": [
        { "value": "page-width", "label": "Página" },
        { "value": "full-width", "label": "Cheia" }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "A Rota — narrativa",
      "category": "t:categories.storytelling",
      "settings": {
        "section_width": "full-width",
        "padding-block-start": 80,
        "padding-block-end": 0
      },
      "blocks": {
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "<p>A Rota</p>",
            "type_preset": "paragraph",
            "case": "uppercase",
            "letter_spacing": "loose",
            "width": "100%",
            "alignment": "center"
          }
        },
        "frase_1": {
          "type": "text",
          "settings": {
            "text": "<h2>Toda caravana segue o mesmo caminho. Um camelo não seguiu.</h2>",
            "type_preset": "h2",
            "width": "100%",
            "alignment": "center"
          }
        },
        "frase_2": {
          "type": "text",
          "settings": {
            "text": "<p>Foi assim que a Rota começou. E ninguém escolhe a rota por você.</p>",
            "type_preset": "paragraph",
            "width": "100%",
            "alignment": "center"
          }
        },
        "cta": {
          "type": "button",
          "settings": {
            "label": "Conheça a Rota",
            "link": "shopify://pages/a-rota",
            "style_class": "button-secondary",
            "width": "fit-content"
          }
        }
      },
      "block_order": ["eyebrow", "frase_1", "frase_2", "cta"]
    }
  ]
}
{% endschema %}
