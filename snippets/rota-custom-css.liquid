{% comment %}
  CSS próprio da Rota das Lupas — ajustes finos que os settings do tema não
  cobrem. Carregado no <head> pelo layout/theme.liquid.
{% endcomment %}
<style>
  /* ----------------------------------------------------------------------
     HERO — tipografia realmente responsiva.
     O sistema fluido do tema trava o mínimo em ~48px para títulos grandes,
     deixando o hero gigante no celular. Aqui o título é discreto no mobile
     e imponente no desktop; o texto de apoio e o preço acompanham.
     ---------------------------------------------------------------------- */
  [id*="hero_rota"] h1 {
    font-size: clamp(2.6rem, 7vw, 5.75rem) !important;
    line-height: 1.03 !important;
    letter-spacing: -0.015em;
  }

  /* "presença." em itálico do serif — acento editorial da assinatura */
  [id*="hero_rota"] h1 em {
    font-style: italic;
  }

  [id*="hero_rota"] p {
    font-size: clamp(0.95rem, 1.9vw, 1.15rem) !important;
    line-height: 1.45 !important;
  }

  /* Véu escuro no rodapé do hero: o texto creme precisa de contraste sobre a
     parte clara da imagem. Escuro embaixo, transparente em cima (o rosto do
     camelo continua visível). */
  [id*="hero_rota"] .overlay--gradient {
    background: linear-gradient(
      to top,
      rgba(18, 24, 14, 0.94) 0%,
      rgba(18, 24, 14, 0.80) 24%,
      rgba(18, 24, 14, 0.52) 46%,
      rgba(18, 24, 14, 0.22) 68%,
      transparent 90%
    ) !important;
  }

  [id*="hero_rota"] h1,
  [id*="hero_rota"] p {
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.55);
  }

  /* ----------------------------------------------------------------------
     PROMO DO HERO — etiqueta discreta + preço em dourado champanhe.
     Mesma fonte do resto do hero (Inter): destaque pela cor e pelo peso,
     não pelo tamanho. Sóbrio e casado com a página.
     ---------------------------------------------------------------------- */
  [id*="hero_rota"] [class*="text_preco_estreia"] p {
    font-size: clamp(0.95rem, 1.9vw, 1.1rem) !important;
    line-height: 1.45 !important;
    color: rgba(247, 242, 231, 0.88) !important;
  }
  [id*="hero_rota"] [class*="text_preco_estreia"] em {
    display: inline-block;
    margin-bottom: 0.15rem;
    font-style: normal;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #e0c281;
  }
  [id*="hero_rota"] [class*="text_preco_estreia"] strong {
    font-weight: 700;
    font-size: 1.15em;
    color: #e7cf96;
    white-space: nowrap;
  }

  /* ----------------------------------------------------------------------
     CTA PRINCIPAL DO HERO ("Comprar agora") — dourado com vida.
     Só o botão primário (.button); o "Ver coleção" é .button-unstyled.
     ---------------------------------------------------------------------- */
  [id*="hero_rota"] .button {
    background: linear-gradient(180deg, #c9a557 0%, #b6893c 100%) !important;
    color: #1a1a17 !important;
    border: none !important;
    font-weight: 600;
    box-shadow:
      0 8px 24px rgba(182, 137, 60, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.28);
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
  }
  @media (hover: hover) {
    [id*="hero_rota"] .button:hover {
      filter: brightness(1.07);
      transform: translateY(-2px);
      box-shadow:
        0 12px 32px rgba(182, 137, 60, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.32);
    }
  }
  [id*="hero_rota"] .button:active {
    transform: translateY(0);
    box-shadow: 0 4px 14px rgba(182, 137, 60, 0.42);
  }

  /* ----------------------------------------------------------------------
     SOBRETÍTULOS (eyebrows) — o tema ignora "case" e "letter_spacing" em
     blocos de texto com preset "paragraph" (só aplica no preset "custom").
     Aqui os eyebrows da home ganham o mesmo tratamento de etiqueta da
     seção rota-modelos: caixa alta, tracking largo, peso forte, oliva.
     ---------------------------------------------------------------------- */
  [class*="text_destaques_eyebrow"] p,
  .rota-narrativa [class*="__eyebrow"] p {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-primary, #2c3a22);
  }

  /* ----------------------------------------------------------------------
     PÁGINA DE PRODUTO — faixa de confiança sob o botão de compra e
     acordeão de informações (envio, trocas, cuidados). Blocos custom-liquid
     no product.json apenas emitem a marcação; o estilo mora aqui.
     ---------------------------------------------------------------------- */
  .rota-pdp-trust {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--color-foreground, #1a1a17) 14%, transparent);
    display: grid;
    gap: 0.7rem;
    font-family: var(--font-body--family, sans-serif);
  }
  .rota-pdp-trust li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.92rem;
    line-height: 1.35;
    color: color-mix(in srgb, var(--color-foreground, #1a1a17) 85%, transparent);
  }
  .rota-pdp-trust svg {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    color: var(--color-primary, #2c3a22);
  }
  .rota-pdp-trust strong { font-weight: 600; }

  .rota-pdp-info {
    margin-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-foreground, #1a1a17) 14%, transparent);
    font-family: var(--font-body--family, sans-serif);
  }
  .rota-pdp-info details {
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground, #1a1a17) 14%, transparent);
  }
  .rota-pdp-info summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    padding: 0.95rem 0;
    font-size: 0.98rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .rota-pdp-info summary::-webkit-details-marker { display: none; }
  .rota-pdp-info summary:hover,
  .rota-pdp-info details[open] summary { color: var(--color-primary, #2c3a22); }
  .rota-pdp-info summary i {
    position: relative;
    flex: 0 0 auto;
    width: 15px; height: 15px;
    color: var(--color-primary, #2c3a22);
  }
  .rota-pdp-info summary i::before,
  .rota-pdp-info summary i::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    background: currentColor;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .rota-pdp-info summary i::after { transform: translateY(-50%) rotate(90deg); }
  .rota-pdp-info details[open] summary i::after { transform: translateY(-50%); opacity: 0; }
  .rota-pdp-info__body {
    padding: 0 0 1rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-foreground, #1a1a17) 78%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .rota-pdp-info details[open] .rota-pdp-info__body {
      animation: rota-pdp-open 0.32s ease;
    }
    @keyframes rota-pdp-open {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: none; }
    }
  }
</style>
