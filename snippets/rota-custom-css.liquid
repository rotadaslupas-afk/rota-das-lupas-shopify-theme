{% comment %}
  CSS próprio da Rota das Lupas — ajustes finos que os settings do tema não
  cobrem. Carregado no <head> pelo layout/theme.liquid.
{% endcomment %}
<style>
  /* ----------------------------------------------------------------------
     HERO — tipografia realmente responsiva.
     O sistema fluido do tema trava o mínimo em ~48px para títulos grandes,
     deixando o hero gigante no celular. Aqui o título é discreto no mobile
     e imponente no desktop; o texto de apoio e o preço acompanham.
     ---------------------------------------------------------------------- */
  [id*="hero_rota"] h1 {
    font-size: clamp(2.6rem, 7vw, 5.75rem) !important;
    line-height: 1.03 !important;
    letter-spacing: -0.015em;
  }

  /* "presença." em itálico do serif — acento editorial da assinatura */
  [id*="hero_rota"] h1 em {
    font-style: italic;
  }

  [id*="hero_rota"] p {
    font-size: clamp(0.95rem, 1.9vw, 1.15rem) !important;
    line-height: 1.45 !important;
  }

  /* Véu escuro no rodapé do hero: o texto creme precisa de contraste sobre a
     parte clara da imagem. Escuro embaixo, transparente em cima (o rosto do
     camelo continua visível). */
  [id*="hero_rota"] .overlay--gradient {
    background: linear-gradient(
      to top,
      rgba(18, 24, 14, 0.82) 0%,
      rgba(18, 24, 14, 0.45) 28%,
      rgba(18, 24, 14, 0.08) 52%,
      transparent 68%
    ) !important;
  }

  [id*="hero_rota"] h1,
  [id*="hero_rota"] p {
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.4);
  }

  /* ----------------------------------------------------------------------
     SOBRETÍTULOS (eyebrows) — o tema ignora "case" e "letter_spacing" em
     blocos de texto com preset "paragraph" (só aplica no preset "custom").
     Aqui os eyebrows da home ganham o mesmo tratamento de etiqueta da
     seção rota-modelos: caixa alta, tracking largo, peso forte, oliva.
     ---------------------------------------------------------------------- */
  [class*="text_destaques_eyebrow"] p,
  .rota-narrativa [class*="__eyebrow"] p {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-primary, #2c3a22);
  }
</style>
